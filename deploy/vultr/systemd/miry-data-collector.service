[Unit]
Description=miry Binance USD-M data collector
Requires=docker.service
After=docker.service network-online.target time-sync.target
Wants=network-online.target time-sync.target
OnFailure=miry-data-collector-alert@%n.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/miry-data-collector/edge.env
WorkingDirectory=/opt/miry-data-collector/deploy/vultr
ExecStart=/usr/bin/docker compose up --no-build --no-deps --abort-on-container-exit --exit-code-from collector
ExecStop=/usr/bin/docker compose stop --timeout 120
SuccessExitStatus=130
Restart=on-failure
RestartSec=15
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
