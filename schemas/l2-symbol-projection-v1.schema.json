{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:miry.market-data:l2-symbol-projection:v1",
  "title": "Miry Market Data L2 Symbol Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "schema_hash",
    "layout",
    "persistent_for_downstream",
    "collector_id",
    "utc_date",
    "normalized_sha256",
    "typed_source_files",
    "typed_source_file_set_hash",
    "symbols",
    "files",
    "schedule",
    "ignored_rows",
    "total_rows",
    "total_bytes",
    "output_root"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "schema_id": {"const": "miry.market-data/l2-symbol-projection/v1"},
    "schema_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "layout": {"const": "PER_SYMBOL_L2_CAUSAL_V1"},
    "persistent_for_downstream": {"const": true},
    "collector_id": {"type": "string", "minLength": 1},
    "utc_date": {"type": "string", "format": "date"},
    "normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "typed_source_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_file_identity"}
    },
    "typed_source_file_set_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/symbol_file"}
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ignored_rows": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "total_rows": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 1},
    "output_root": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "source_file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "size_bytes", "content_hash", "identity_hash"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "identity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "symbol_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "size_bytes", "sha256"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}

